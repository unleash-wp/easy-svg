# What must NOT reach wordpress.org.
#
# Read by the deploy workflow (10up/action-wordpress-plugin-deploy runs
# `rsync --exclude-from=.distignore` into SVN trunk). .gitattributes carries
# the same list as export-ignore, so `git archive` builds the same tree, and
# tests/run.php checks the two lists against each other.
#
# Anchored with a leading slash: only this repository's top level.

# The repository itself, and how it is built and checked.
/.git
/.github
/.wordpress-org
/.distignore
/.gitattributes
/.gitignore
/composer.json
/composer.lock
/RELEASING.md
/README.md
# Never committed, but a local build rsyncs the working directory: the file is
# notes for whoever works on this repository, and a customer is not that.
/CLAUDE.md
/AGENTS.md
/docs
/tests

# Non-runtime files inside the bundled library. Its LICENSE stays.
# svg-scanner.php is a command-line tool, not part of the sanitiser.
/vendor/enshrined/svg-sanitize/src/svg-scanner.php
/vendor/enshrined/svg-sanitize/README.md
/vendor/enshrined/svg-sanitize/CHANGELOG.md
/vendor/enshrined/svg-sanitize/composer.json

# A mac writes these without being asked.
.DS_Store

# How this plugin is built, checked and translated. None of it runs on a
# customer's site, and a shell script in a plugin directory is a question a
# wordpress.org reviewer should never have to ask.
/scripts

# The panel build toolchain. The compiled build/ ships; the toolchain does not.
# public/ is the fonts' source of truth; vite copies it into build/fonts.
/public
/src
/node_modules
/package.json
/package-lock.json
/vite.config.js
/eslint.config.mjs
/.wp-env.json
/playwright.config.js
/e2e
/playwright-report
/test-results
