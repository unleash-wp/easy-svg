#: build/panel.js
msgid "Settings"
msgstr "Einstellungen"

#: build/panel.js
msgid "Icon library"
msgstr "Icon-Library"

#: build/panel.js
msgid "Icon Sets"
msgstr "Icon Sets"

#: build/panel.js
msgid "Bundle SVGs into collections and render them with the Icon block or easy_svg_icon()."
msgstr "Bündele SVGs zu Collections und rendere sie per Icon-Block oder easy_svg_icon()."

#: build/panel.js
msgid "Configurator"
msgstr "Configurator"

#: build/panel.js
msgid "Extend the sanitiser allow-list for special icon libraries — with guard-rails."
msgstr "Erweitere die Sanitizer-Allow-Liste für spezielle Icon-Bibliotheken — mit Guard-Rails."

#: build/panel.js
msgid "Audit"
msgstr "Audit"

#: build/panel.js
msgid "Find and clean up SVGs that did not come through the uploader."
msgstr "Finde und säubere SVGs, die nicht über den Uploader kamen."

#: build/panel.js
msgid "Licence"
msgstr "Lizenz"

#: build/panel.js
msgid "Enter your licence key and unlock the Pro features."
msgstr "Lizenzschlüssel eingeben und Pro-Features freischalten."

#: build/panel.js
msgid "Pro"
msgstr "Pro"

#: build/panel.js
msgid "General"
msgstr "Allgemein"

#: build/panel.js
msgid "SVG uploads, the icon library and — with Pro — collections, configurator, audit and licence, all in one place."
msgstr "SVG-Uploads, Icon-Library und — mit Pro — Collections, Configurator, Audit und Lizenz, alles an einem Ort."

#: build/panel.js
msgid "Activate licence"
msgstr "Lizenz aktivieren"

#: build/panel.js
msgid "Get Easy SVG Pro"
msgstr "Easy SVG Pro holen"

#: includes/panel.php:250
#: build/panel.js
msgid "The icon library is off. Switch it on under the Settings tab."
msgstr "Die Icon-Library ist aus. Schalte sie im Tab „Einstellungen“ ein."

#: build/panel.js
msgid "Optional — a slug is derived from it."
msgstr "Optional — daraus wird ein Slug abgeleitet."

#: build/panel.js
msgid "e.g. arrow-right"
msgstr "z. B. pfeil-rechts"

#: build/panel.js
msgid "SVG markup"
msgstr "SVG-Markup"

#: build/panel.js
msgid "Preview"
msgstr "Vorschau"

#: build/panel.js
msgid "Adding…"
msgstr "Fügt hinzu…"

#: build/panel.js
msgid "Add"
msgstr "Hinzufügen"

#: build/panel.js
msgid "Your icons"
msgstr "Deine Icons"

#. translators: %d: number of icons in the library.
#: build/panel.js
#, js-format
msgid "%d icon in the library."
msgid_plural "%d icons in the library."
msgstr[0] "%d Icon in der Library."
msgstr[1] "%d Icons in der Library."

#. translators: %s: icon name.
#: build/panel.js
#, js-format
msgid "Delete %s"
msgstr "%s löschen"

#: build/panel.js
msgid "Features"
msgstr "Features"

#: build/panel.js
msgid "Both are off by default. The security layer (every SVG is sanitised, plus the size cap) is always on — there is no switch for it."
msgstr "Beide sind standardmäßig aus. Die Sicherheitsschicht (jede SVG wird bereinigt, plus das Größen-Limit) ist immer aktiv — dafür gibt es keinen Schalter."

#: build/panel.js
msgid "Allow SVG uploads in the media library"
msgstr "SVG-Uploads in der Mediathek erlauben"

#: build/panel.js
msgid "Editors can upload .svg files; each one is sanitised on the way in."
msgstr "Redakteure können .svg-Dateien hochladen; jede wird beim Upload bereinigt."

#: build/panel.js
msgid "Enable the icon library"
msgstr "Icon-Library aktivieren"

#: build/panel.js
msgid "Adds the Icon library tab and the Icon block."
msgstr "Fügt den Tab „Icon-Library“ und den Icon-Block hinzu."

#: build/panel.js
msgid "Security"
msgstr "Sicherheit"

#: build/panel.js
msgid "The cap limits what the sanitiser will parse — always on, regardless of the features above."
msgstr "Das Limit begrenzt, was der Sanitizer parst — immer aktiv, unabhängig von den Features oben."

#: build/panel.js
msgid "Files larger than this are rejected before the sanitiser runs."
msgstr "Größere Dateien werden abgewiesen, bevor der Sanitizer läuft."

#: build/panel.js
msgid "Unsaved changes"
msgstr "Ungespeicherte Änderungen"

#: build/panel.js
msgid "All changes saved"
msgstr "Alle Änderungen gespeichert"

#: build/panel.js
msgid "Save"
msgstr "Speichern"

#: build/panel.js
msgid "Saving…"
msgstr "Speichert…"

#: build/panel.js
msgid "Reset"
msgstr "Zurücksetzen"

#: build/panel.js
msgid "Easy SVG Pro"
msgstr "Easy SVG Pro"

#: build/panel.js
msgid "The agency layer for SVG icons — all right here in the panel, once Pro is active and licensed."
msgstr "Die Agentur-Schicht für SVG-Icons — alles direkt hier im Panel, sobald Pro aktiv und lizenziert ist."

#: includes/panel.php:233
msgid "That SVG is larger than the size allowed in Settings."
msgstr "Dieses SVG ist größer als die im Tab „Einstellungen“ erlaubte Größe."

#: includes/panel.php:235
msgid "That SVG has too many parts to be read safely."
msgstr "Dieses SVG hat zu viele Teile, um sicher gelesen zu werden."

#. translators: %s: link to the Icons panel.
#: includes/settings.php:166
#, php-format
msgid "Easy SVG 5.0: your SVG uploads stay on. New in 5.0 — an icon library and a settings panel. Manage both under %s."
msgstr "Easy SVG 5.0: Deine SVG-Uploads bleiben an. Neu in 5.0 — eine Icon-Library und ein Einstellungs-Panel. Beides findest du unter %s."

#: includes/panel.php:286
msgid "An icon needs a name."
msgstr "Ein Icon braucht einen Namen."

#: includes/panel.php:325
msgid "The icon could not be renamed."
msgstr "Das Icon konnte nicht umbenannt werden."

#: build/panel.js
msgid "That file could not be read."
msgstr "Diese Datei konnte nicht gelesen werden."

#. translators: 1: number of files stored, 2: number of files picked.
#: build/panel.js
#, js-format
msgid "%1$d of %2$d file stored."
msgid_plural "%1$d of %2$d files stored."
msgstr[0] "%1$d von %2$d Datei gespeichert."
msgstr[1] "%1$d von %2$d Dateien gespeichert."

#. translators: %d: number of icons removed.
#: build/panel.js
#, js-format
msgid "%d icon removed."
msgid_plural "%d icons removed."
msgstr[0] "%d Icon entfernt."
msgstr[1] "%d Icons entfernt."

#: build/panel.js
msgid "Icon renamed."
msgstr "Icon umbenannt."

#. translators: %s: the PHP call that renders the icon, e.g. easy_svg_icon( 'heart' ).
#: build/panel.js
#, js-format
msgid "Copied %s to the clipboard."
msgstr "%s in die Zwischenablage kopiert."

#. translators: %s: the PHP call that renders the icon, e.g. easy_svg_icon( 'heart' ).
#: build/panel.js
#, js-format
msgid "The clipboard is not available here. The call is %s."
msgstr "Die Zwischenablage ist hier nicht verfügbar. Der Aufruf lautet %s."

#: build/panel.js
msgid "Paste markup"
msgstr "Markup einfügen"

#: build/panel.js
msgid "Dismiss this report"
msgstr "Diesen Bericht schließen"

#: build/panel.js
msgid "Drop your first SVG here"
msgstr "Leg dein erstes SVG hier ab"

#: build/panel.js
msgid "Every file is sanitised and hardened on the way in — the same bar as a media upload."
msgstr "Jede Datei wird beim Hereinkommen bereinigt und gehärtet — dieselbe Messlatte wie ein Medien-Upload."

#: build/panel.js
msgid "Choose an SVG"
msgstr "SVG auswählen"

#: build/panel.js
msgid "There is no limit on how many icons you keep."
msgstr "Wie viele Icons du behältst, ist nicht begrenzt."

#: build/panel.js
msgid "Search icons by name or slug"
msgstr "Icons nach Name oder Slug durchsuchen"

#: build/panel.js
msgid "Search icons…"
msgstr "Icons durchsuchen…"

#: build/panel.js
msgid "Done selecting"
msgstr "Auswahl beenden"

#: build/panel.js
msgid "Select several"
msgstr "Mehrere auswählen"

#. translators: 1: number of icons matching the search, 2: number of icons in the library.
#: build/panel.js
#, js-format
msgid "Showing %1$d of %2$d icon."
msgid_plural "Showing %1$d of %2$d icons."
msgstr[0] "%1$d von %2$d Icon wird angezeigt."
msgstr[1] "%1$d von %2$d Icons werden angezeigt."

#. translators: %d: number of icons selected.
#: build/panel.js
#, js-format
msgid "%d icon selected"
msgid_plural "%d icons selected"
msgstr[0] "%d Icon ausgewählt"
msgstr[1] "%d Icons ausgewählt"

#: build/panel.js
msgid "Remove"
msgstr "Entfernen"

#: build/panel.js
msgid "Drop an SVG or choose one"
msgstr "SVG ablegen oder wählen"

#: build/panel.js
msgid "No icon matches that search."
msgstr "Kein Icon passt zu dieser Suche."

#. translators: %s: icon name.
#: build/panel.js
#, js-format
msgid "Select %s"
msgstr "%s auswählen"

#. translators: %s: the icon's current name.
#: build/panel.js
#, js-format
msgid "New name for %s"
msgstr "Neuer Name für %s"

#: build/panel.js
msgid "Cancel"
msgstr "Abbrechen"

#. translators: %s: icon name.
#: build/panel.js
#, js-format
msgid "Copy the call for %s"
msgstr "Aufruf für %s kopieren"

#. translators: %s: icon name.
#: build/panel.js
#, js-format
msgid "Rename %s"
msgstr "%s umbenennen"

#: build/panel.js
msgid "Paste the <svg>…</svg>. It is sanitised and hardened before it is stored, exactly like a dropped file."
msgstr "Füge das <svg>…</svg> ein. Es wird bereinigt und gehärtet, bevor es gespeichert wird — genau wie eine abgelegte Datei."
