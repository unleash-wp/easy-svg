#. translators: %s: path of the file the older sanitizer was loaded from
#: easy-svg.php:358
#, php-format
msgid "Easy SVG Support: another plugin has loaded an older version of the SVG sanitizer (%s) before this plugin could load its own, so SVG uploads are being sanitized with that older version. Please update or deactivate the plugin it belongs to."
msgstr "Easy SVG Support: Ein anderes Plugin hat eine ältere Version des SVG-Sanitizers (%s) geladen, bevor dieses Plugin seine eigene laden konnte, daher werden SVG-Uploads mit dieser älteren Version bereinigt. Bitte aktualisiere oder deaktiviere das zugehörige Plugin."

#: easy-svg.php:510
msgid "Sorry, this SVG file is not allowed for security reasons."
msgstr "Diese SVG-Datei ist aus Sicherheitsgründen leider nicht erlaubt."

#: easy-svg.php:518
msgid "Sorry, please check your SVG file."
msgstr "Bitte überprüfe deine SVG-Datei."

#: easy-svg.php:669
msgid "This SVG file contains content this site does not allow. Please upload it through the media library, which cleans it."
msgstr "Diese SVG-Datei enthält Inhalte, die diese Website nicht erlaubt. Bitte lade sie über die Mediathek hoch, die sie bereinigt."

