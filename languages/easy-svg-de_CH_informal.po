msgstr ""

#. Description of the plugin
#: easy-svg.php
msgid "Add SVG support for WordPress."
msgstr "Fügt WordPress SVG-Unterstützung hinzu."

#. Author of the plugin
#: easy-svg.php
msgid "UnleashWP"
msgstr ""

#. Author URI of the plugin
