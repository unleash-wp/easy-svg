msgid_plural "%1$d of %2$d files stored."
msgstr[0] "%1$d von %2$d Datei gespeichert."
msgstr[1] "%1$d von %2$d Dateien gespeichert."

#: build/panel.js
msgid "The media library did not load on this screen."
msgstr "Die Mediathek wurde auf diesem Bildschirm nicht geladen."

#: build/panel.js
