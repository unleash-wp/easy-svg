msgstr "Schließen"

#. translators: 1: how many icons are stored, 2: how many this screen lists.
#: build/panel.js
msgid ""
"This site has %1$d icons and this screen lists %2$d of them. The rest are "
"stored and still work in templates and the Icon block."
msgstr ""
"Diese Website hat %1$d Icons, diese Ansicht listet %2$d davon. Die übrigen "
"sind gespeichert und funktionieren weiterhin in Templates und im Icon-Block."

#: build/panel.js
msgid "Dismiss this report"
msgstr "Diesen Bericht schließen"

#: build/panel.js
msgid "Your icons"
msgstr "Deine Icons"

#. translators: %d: number of icons in the library.
#: build/panel.js
msgid "%d icon in the library."
msgid_plural "%d icons in the library."
msgstr[0] "%d Icon in der Bibliothek."
msgstr[1] "%d Icons in der Bibliothek."

#: build/panel.js
msgid "Search icons by name or slug"
msgstr "Icons nach Name oder Slug durchsuchen"

#: build/panel.js
msgid "Search icons…"
msgstr "Icons durchsuchen…"

#: build/panel.js
msgid "Done selecting"
msgstr "Auswahl beenden"

#: build/panel.js
